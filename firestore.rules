rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users can read/write their own investigations and reports
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Mission notes and tactical intelligence logs
    match /mission_notes/{noteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Agent analyses and search queries history
    match /agent_logs/{logId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default match
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
